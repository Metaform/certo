{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CertificateAcceptanceStatus",
  "type": "object",
  "required": [
    "exchangeId",
    "status"
  ],
  "properties": {
    "exchangeId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "RETRIEVED",
        "ACCEPTED",
        "REJECTED",
        "ERRORED"
      ]
    },
    "certificateId": {
      "$ref": "./common.schema.json#/definitions/Uuid"
    },
    "revision": {
      "$ref": "./common.schema.json#/definitions/Revision"
    },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./common.schema.json#/definitions/StatusError"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "REJECTED",
              "ERRORED"
            ]
          }
        }
      },
      "then": {
        "required": [
          "errors"
        ]
      },
      "else": {
        "not": {
          "required": [
            "errors"
          ]
        }
      }
    }
  ]
}
