{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CertificateSearchRequest",
  "type": "object",
  "properties": {
    "certificateId": {
      "$ref": "./common.schema.json#/definitions/Uuid"
    },
    "certificateType": {
      "type": "string",
      "pattern": "^[a-z0-9]+$"
    },
    "certifiedLocations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./common.schema.json#/definitions/LocationReference"
      }
    }
  }
}
