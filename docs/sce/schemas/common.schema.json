{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Common definitions",
  "definitions": {
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "Revision": {
      "type": "integer",
      "minimum": 1
    },
    "StatusError": {
      "type": "object",
      "required": [
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1
        },
        "specifier": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "LocationReference": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "legalEntityId": {
          "type": "string",
          "minLength": 1
        },
        "siteId": {
          "type": "string",
          "minLength": 1
        },
        "addressId": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
