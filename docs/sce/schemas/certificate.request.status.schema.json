{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CertificateRequestStatus",
  "type": "object",
  "required": [
    "exchangeId",
    "status"
  ],
  "properties": {
    "exchangeId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "ACKNOWLEDGED",
        "CERTIFICATE_REQUESTED",
        "FULFILLED",
        "DECLINED",
        "FAILED"
      ]
    },
    "certificateId": {
      "$ref": "./common.schema.json#/definitions/Uuid"
    },
    "revision": {
      "$ref": "./common.schema.json#/definitions/Revision"
    },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./common.schema.json#/definitions/StatusError"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "FULFILLED"
          }
        }
      },
      "then": {
        "required": [
          "certificateId",
          "revision"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "DECLINED",
              "FAILED"
            ]
          }
        }
      },
      "then": {
        "required": [
          "errors"
        ]
      }
    }
  ]
}
