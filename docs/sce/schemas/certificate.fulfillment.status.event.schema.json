{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CertificateFulfillmentStatusEvent",
  "allOf": [
    {
      "$ref": "./event.schema.json"
    },
    {
      "type": "object",
      "required": [
        "subject",
        "data"
      ],
      "properties": {
        "type": {
          "const": "org.dsaf.sce.CertificateFulfillmentStatus.v1"
        },
        "data": {
          "allOf": [
            {
              "$ref": "./exchange.schema.json"
            },
            {
              "properties": {
                "status": {
                  "enum": [
                    "PENDING",
                    "FULFILLED",
                    "DECLINED"
                  ]
                }
              }
            }
          ]
        }
      }
    }
  ]
}
