{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Exchange",
  "type": "object",
  "required": [
    "exchangeId",
    "status"
  ],
  "properties": {
    "exchangeId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "RECEIVED",
        "FULFILLED",
        "DECLINED",
        "ACCEPTED",
        "REJECTED"
      ]
    },
    "certificate": {
      "anyOf": [
        {
          "$ref": "./certificate.schema.json"
        },
        {
          "type": "object",
          "description": "The reference form: only the pinned certificate version.",
          "required": [
            "certificateId",
            "revision"
          ],
          "properties": {
            "certificateId": {
              "$ref": "./common.schema.json#/definitions/Uuid"
            },
            "revision": {
              "$ref": "./common.schema.json#/definitions/Revision"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./common.schema.json#/definitions/StatusError"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "FULFILLED",
              "ACCEPTED",
              "REJECTED"
            ]
          }
        }
      },
      "then": {
        "required": [
          "certificate"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "DECLINED",
              "REJECTED"
            ]
          }
        }
      },
      "then": {
        "required": [
          "errors"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "DECLINED"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "certificate"
          ]
        }
      }
    }
  ]
}
