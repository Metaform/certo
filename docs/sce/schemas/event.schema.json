{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event",
  "type": "object",
  "required": [
    "specversion",
    "type",
    "source",
    "id"
  ],
  "properties": {
    "specversion": {
      "type": "string",
      "const": "1.0"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "format": "uri-reference",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "datacontenttype": {
      "type": "string"
    },
    "dataschema": {
      "type": "string",
      "format": "uri"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "dataspaceidentifier": {
      "type": "string",
      "minLength": 1
    },
    "data": {},
    "data_base64": {
      "type": "string",
      "contentEncoding": "base64"
    }
  },
  "not": {
    "required": [
      "data",
      "data_base64"
    ]
  },
  "additionalProperties": true
}
